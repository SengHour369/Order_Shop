    {
      "name": "Payment Integration Workflows",
      "item": [
        {
          "name": "1. Complete Payment Flow - Initialize",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"KHR\",\n  \"amount\": 150000,\n  \"merchantName\": \"E_Shop\",\n  \"merchantCity\": \"PHNOM PENH\",\n  \"merchantId\": \"ESHOP001\",\n  \"acquiringBank\": \"NBC\",\n  \"billNumber\": \"ORDER-2026-05-14-12345\",\n  \"storeLabel\": \"ONLINE_STORE\",\n  \"mobileNumber\": \"+855989990000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bakong/generate-qr",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bakong",
                "generate-qr"
              ]
            },
            "description": "Step 1: Generate QR code for the payment. Save the QRCode from response."
          }
        },
        {
          "name": "2. Complete Payment Flow - Convert to Image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr\": \"00020101021229370016A0000000727302150senghour_soeurng@bkrt0215ESHOP00105303KHR5900000150001\",\n  \"md5\": \"transaction_id\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bakong/get-qr-image",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bakong",
                "get-qr-image"
              ]
            },
            "description": "Step 2: Convert QR code string to PNG image. Display this to customer."
          }
        },
        {
          "name": "3. Complete Payment Flow - Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"md5\": \"transaction_id\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bakong/check-transaction",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bakong",
                "check-transaction"
              ]
            },
            "description": "Step 3: After customer completes payment, verify transaction status."
          }
        }
