    {
      "name": "Bakong QR Code Generation",
      "item": [
        {
          "name": "Generate QR Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"KHR\",\n  \"amount\": 100000,\n  \"merchantName\": \"E_Shop\",\n  \"merchantCity\": \"PHNOM PENH\",\n  \"merchantId\": \"{{bakong_merchant_id}}\",\n  \"acquiringBank\": \"NBC\",\n  \"billNumber\": \"BILL00001\",\n  \"storeLabel\": \"E_SHOP_STORE\",\n  \"terminalLabel\": \"TERMINAL_01\",\n  \"mobileNumber\": \"012345678\",\n  \"purposeOfTransaction\": \"Payment for Order\",\n  \"expirationTimestamp\": 15\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bakong/generate-qr",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bakong",
                "generate-qr"
              ]
            },
            "description": "Generate KHQR code string for payment. Returns QR code data that can be encoded into an image."
          }
        },
